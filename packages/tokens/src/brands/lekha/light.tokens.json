{
  "$description": "Lekha brand, light mode: warm paper, ink text, one muted teal accent.",
  "color": {
    "$type": "color",
    "surface": { "default": { "$value": "{color.paper.50}" }, "subtle": { "$value": "{color.paper.100}" } },
    "text": { "default": { "$value": "{color.paper.900}" }, "muted": { "$value": "{color.paper.600}" }, "on-accent": { "$value": "{color.white}" }, "on-danger": { "$value": "{color.white}" } },
    "border": { "subtle": { "$value": "{color.paper.200}" }, "control": { "$value": "{color.paper.500}" } },
    "accent": { "default": { "$value": "{color.teal.600}" }, "hover": { "$value": "{color.teal.700}" } },
    "danger": { "default": { "$value": "{color.brick.600}" }, "hover": { "$value": "{color.brick.700}" } },
    "focus": { "$value": "{color.teal.600}" }
  }
}
