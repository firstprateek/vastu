    "surface": {
      "default": {
        "$value": "{color.sandstone.50}",
        "$description": "Page and component background"
      },
      "subtle": {
        "$value": "{color.sandstone.100}",
        "$description": "Hover backgrounds, read-only fields, quiet panels"
      }
    },
    "text": {
      "default": {
        "$value": "{color.indigo.950}",
        "$description": "Body text and headings"
      },
      "muted": {
