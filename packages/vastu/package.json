{
  "name": "@firstprateek/vastu",
  "version": "1.0.0",
  "description": "Vastu web components, built with Lit: accessible, themeable through tokens, and described in a manifest that agents can read",
  "type": "module",
  "exports": {
    "./bar-chart": {
      "types": "./dist/dev/bar-chart/index.d.ts",
      "development": "./dist/dev/bar-chart/index.js",
      "default": "./dist/prod/bar-chart/index.js"
    },
    "./button": {
      "types": "./dist/dev/button/index.d.ts",
      "development": "./dist/dev/button/index.js",
      "default": "./dist/prod/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/dev/checkbox/index.d.ts",
      "development": "./dist/dev/checkbox/index.js",
      "default": "./dist/prod/checkbox/index.js"
    },
    "./dialog": {
      "types": "./dist/dev/dialog/index.d.ts",
      "development": "./dist/dev/dialog/index.js",
      "default": "./dist/prod/dialog/index.js"
    },
    "./menu": {
      "types": "./dist/dev/menu/index.d.ts",
      "development": "./dist/dev/menu/index.js",
      "default": "./dist/prod/menu/index.js"
    },
    "./navbar": {
      "types": "./dist/dev/navbar/index.d.ts",
      "development": "./dist/dev/navbar/index.js",
      "default": "./dist/prod/navbar/index.js"
    },
    "./poll": {
      "types": "./dist/dev/poll/index.d.ts",
      "development": "./dist/dev/poll/index.js",
      "default": "./dist/prod/poll/index.js"
    },
    "./switch": {
      "types": "./dist/dev/switch/index.d.ts",
      "development": "./dist/dev/switch/index.js",
      "default": "./dist/prod/switch/index.js"
    },
    "./tabs": {
      "types": "./dist/dev/tabs/index.d.ts",
      "development": "./dist/dev/tabs/index.js",
      "default": "./dist/prod/tabs/index.js"
    },
    "./text-field": {
      "types": "./dist/dev/text-field/index.d.ts",
      "development": "./dist/dev/text-field/index.js",
      "default": "./dist/prod/text-field/index.js"
    },
    "./toast": {
      "types": "./dist/dev/toast/index.d.ts",
      "development": "./dist/dev/toast/index.js",
      "default": "./dist/prod/toast/index.js"
    },
    "./all": {
      "types": "./dist/dev/all.d.ts",
      "development": "./dist/dev/all.js",
      "default": "./dist/prod/all.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/*/*/index.js",
    "./dist/*/all.js"
  ],
  "scripts": {
    "build": "node build.js",
    "analyze": "cem analyze --config cem.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firstprateek/vastu.git",
    "directory": "packages/vastu"
  },
  "homepage": "https://firstprateek.github.io/vastu/",
  "keywords": [
    "web components",
    "lit",
    "design system",
    "accessibility",
    "custom elements"
  ],
  "license": "ISC",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@firstprateek/vastu-tokens": "workspace:^"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@firstprateek/vastu-tokens": "workspace:^",
    "typescript": "~5.9.3"
  },
  "bugs": {
    "url": "https://github.com/firstprateek/vastu/issues"
  },
  "author": "firstprateek"
}
