---
import '@firstprateek/vastu-tokens/lekha.css';
import { components, slug, title as nameOf } from '../lib/manifest';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-va-brand="lekha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title === 'Vastu' ? 'Vastu design system' : `${title} · Vastu`}</title>
    <script is:inline>
      // Apply the saved mode before first paint, so the page doesn't flash.
      try {
        const mode = localStorage.getItem('va-mode');
        if (mode) document.documentElement.dataset.vaMode = mode;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href={base}>Vastu</a>
      <nav aria-label="Components">
        {
          components.map((c) => (
            <a href={`${base}components/${slug(c.tagName)}/`} aria-current={path.includes(`/components/${slug(c.tagName)}/`) ? 'page' : undefined}>
              {nameOf(c.tagName)}
            </a>
          ))
        }
        <a href="https://github.com/firstprateek/vastu">GitHub</a>
      </nav>
      <label class="mode">
        <span>Mode</span>
        <select id="mode-select">
          <option value="">Follow system</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
          <option value="high-contrast">High contrast</option>
        </select>
      </label>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      Vastu is a work in progress (milestone M0). Brand: Lekha. <a href="https://github.com/firstprateek/vastu/blob/main/docs/design.md">Design document</a>.
    </footer>
  </body>
</html>

<script>
  const select = document.querySelector<HTMLSelectElement>('#mode-select')!;
  select.value = document.documentElement.dataset.vaMode ?? '';
  select.addEventListener('change', () => {
    const mode = select.value;
    if (mode) document.documentElement.dataset.vaMode = mode;
    else delete document.documentElement.dataset.vaMode;
    try {
      if (mode) localStorage.setItem('va-mode', mode);
      else localStorage.removeItem('va-mode');
    } catch {}
  });
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--va-color-surface-default);
    color: var(--va-color-text-default);
    font: 1.0625rem/1.6 var(--va-font-family-reading);
  }
  a {
    color: var(--va-color-accent-default);
  }
  :focus-visible {
    outline: var(--va-size-focus-ring) solid var(--va-color-focus);
    outline-offset: 2px;
  }
  code {
    font-family: var(--va-font-family-mono);
    font-size: 0.875em;
  }
  h1,
  h2,
  h3 {
    font-family: var(--va-font-family-reading);
    font-weight: var(--va-font-weight-bold);
    line-height: 1.25;
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 10;
    background: var(--va-color-surface-default);
    padding: 4px 8px;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--va-color-border-subtle);
    font-family: var(--va-font-family-ui);
    font-size: var(--va-font-size-sm);
  }
  .brand {
    font-family: var(--va-font-family-reading);
    font-size: 1.25rem;
    font-weight: var(--va-font-weight-bold);
    color: var(--va-color-text-default);
    text-decoration: none;
  }
  .top nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    flex: 1;
  }
  .top nav a {
    color: var(--va-color-text-muted);
    text-decoration: none;
  }
  .top nav a[aria-current='page'] {
    color: var(--va-color-text-default);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 600px) {
    /* Brand and mode on the first row, the component links on a full-width row below. */
    .top .brand {
      flex: 1;
    }
    .top nav {
      order: 3;
      flex-basis: 100%;
    }
  }
  .mode {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--va-color-text-muted);
  }
  .mode select {
    font: inherit;
    color: var(--va-color-text-default);
    background: var(--va-color-surface-default);
    border: 1px solid var(--va-color-border-control);
    border-radius: var(--va-radius-control);
    padding: 4px 6px;
    min-height: 32px;
  }
  main {
    max-width: 52rem;
    margin: 0 auto;
    padding: 24px 16px 48px;
  }
  footer {
    max-width: 52rem;
    margin: 0 auto;
    padding: 24px 16px 48px;
    border-top: 1px solid var(--va-color-border-subtle);
    color: var(--va-color-text-muted);
    font-family: var(--va-font-family-ui);
    font-size: var(--va-font-size-sm);
  }
</style>
