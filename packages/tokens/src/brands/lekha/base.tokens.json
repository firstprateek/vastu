{
  "$description": "Lekha brand, mode-independent system tokens: type, shape, space, size, motion.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "Controls and UI text" },
      "reading": { "$value": ["Source Serif 4", "Source Serif Pro", "Georgia", "serif"], "$description": "Headings and long-form text" },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$value": { "value": 1.125, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 600 }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 2, "unit": "px" }, "$description": "Buttons, fields: near-square, as on the personal site" },
    "surface": { "$value": { "value": 4, "unit": "px" } },
    "round": { "$value": { "value": 999, "unit": "px" } }
  },
  "space": {
    "$type": "dimension",
    "inline": {
      "xs": { "$value": "{dimension.1}" },
      "sm": { "$value": "{dimension.2}" },
      "md": { "$value": "{dimension.3}" },
      "lg": { "$value": "{dimension.5}" }
    },
    "gap": {
      "sm": { "$value": "{dimension.1}" },
      "md": { "$value": "{dimension.2}" }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": { "value": 2, "unit": "rem" }, "$description": "32px: still above the 24px WCAG 2.2 target size" },
      "md": { "$value": { "value": 2.5, "unit": "rem" } },
      "lg": { "$value": { "value": 3, "unit": "rem" } }
    },
    "focus-ring": { "$value": { "value": 2, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "slow": { "$value": { "value": 240, "unit": "ms" } }
    }
  }
}
