{
  "name": "vastu-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:docs": "pnpm --filter vastu-docs run build",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/vastu --noEmit",
    "test:unit": "vitest run",
    "test:browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "size": "size-limit",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:browser && pnpm size",
    "eval": "node tests/eval/run.js",
    "eval:dry": "node tests/eval/run.js --dry-run",
    "bench": "node tests/bench/render.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.0",
    "@firstprateek/vastu-lint": "workspace:*",
    "@firstprateek/vastu-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.65.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.14.0",
    "size-limit": "^14.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
