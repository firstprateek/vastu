{
  "html": "<div class=\"format-toolbar\" role=\"group\" aria-label=\"Text formatting\">\n  <va-button variant=\"ghost\" label=\"Bold\">\n    <svg aria-hidden=\"true\" focusable=\"false\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 5h6a3.5 3.5 0 0 1 0 7H7z\"/><path d=\"M7 12h7a3.5 3.5 0 0 1 0 7H7z\"/></svg>\n  </va-button>\n  <va-button variant=\"ghost\" label=\"Italic\">\n    <svg aria-hidden=\"true\" focusable=\"false\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 4h-9\"/><path d=\"M14 20H5\"/><path d=\"M15 4 9 20\"/></svg>\n  </va-button>\n  <va-button variant=\"ghost\" label=\"Underline\">\n    <svg aria-hidden=\"true\" focusable=\"false\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 4v6a6 6 0 0 0 12 0V4\"/><path d=\"M4 20h16\"/></svg>\n  </va-button>\n</div>\n",
  "css": ".format-toolbar {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-space-gap-sm);\n  padding: var(--va-space-gap-sm);\n  background: var(--va-color-surface-default);\n  border: 1px solid var(--va-color-border-subtle);\n  border-radius: var(--va-radius-surface);\n}\n\n.format-toolbar va-button {\n  --va-button-padding-inline: var(--va-space-inline-sm);\n}\n\n.format-toolbar svg {\n  display: block;\n  width: 1.25rem;\n  height: 1.25rem;\n}\n"
