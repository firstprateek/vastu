{
  "$description": "Vastu brand, dark mode: indigo night, sandstone text, a pale indigo accent.",
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{color.dusk.900}"
      },
      "subtle": {
        "$value": "{color.dusk.800}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.dusk.50}"
      },
      "muted": {
        "$value": "{color.dusk.400}"
      },
      "on-accent": {
        "$value": "{color.dusk.900}"
      },
      "on-danger": {
        "$value": "{color.dusk.900}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.dusk.700}"
