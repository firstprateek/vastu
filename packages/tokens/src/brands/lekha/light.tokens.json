{
  "$description": "Lekha brand, light mode: warm paper, ink text, one muted teal accent.",
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{color.paper.50}",
        "$description": "Page and component background"
      },
      "subtle": {
        "$value": "{color.paper.100}",
        "$description": "Hover backgrounds, read-only fields, quiet panels"
      }
    },
    "text": {
      "default": {
        "$value": "{color.paper.900}",
        "$description": "Body text and headings"
      },
      "muted": {
        "$value": "{color.paper.600}",
        "$description": "Secondary text: help text, captions, metadata"
      },
      "on-accent": {
        "$value": "{color.white}",
        "$description": "Text and icons on an accent background"
      },
      "on-danger": {
        "$value": "{color.white}",
        "$description": "Text and icons on a danger background"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.paper.200}",
        "$description": "Dividers, card and panel borders"
      },
      "control": {
        "$value": "{color.paper.500}",
        "$description": "Borders of inputs and secondary buttons"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.teal.600}",
        "$description": "Primary actions, links, selected and checked states"
      },
      "hover": {
        "$value": "{color.teal.700}",
        "$description": "Hover state of accent backgrounds"
      }
    },
    "danger": {
      "default": {
        "$value": "{color.brick.600}",
        "$description": "Destructive actions and error text"
      },
      "hover": {
        "$value": "{color.brick.700}",
        "$description": "Hover state of danger backgrounds"
      }
    },
    "focus": {
      "$value": "{color.teal.600}",
      "$description": "Keyboard focus ring"
    }
  }
}
