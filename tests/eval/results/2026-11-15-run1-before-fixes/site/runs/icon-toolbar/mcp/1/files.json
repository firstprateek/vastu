{
  "html": "<div class=\"format-toolbar\" role=\"group\" aria-label=\"Text formatting\">\n  <va-button variant=\"ghost\" size=\"sm\" label=\"Bold\">\n    <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 5h6a3.5 3.5 0 0 1 0 7H7z\"/><path d=\"M7 12h7a3.5 3.5 0 0 1 0 7H7z\"/></svg>\n  </va-button>\n  <va-button variant=\"ghost\" size=\"sm\" label=\"Italic\">\n    <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 5h8M6 19h8M14 5l-4 14\"/></svg>\n  </va-button>\n  <va-button variant=\"ghost\" size=\"sm\" label=\"Underline\">\n    <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 4v7a5 5 0 0 0 10 0V4\"/><path d=\"M5 20h14\"/></svg>\n  </va-button>\n</div>\n",
  "css": ".format-toolbar {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--va-space-gap-sm);\n  padding: var(--va-space-inline-xs);\n  background: var(--va-color-surface-subtle);\n  border: 1px solid var(--va-color-border-subtle);\n  border-radius: var(--va-radius-surface);\n}\n\n.format-toolbar va-button {\n  --va-button-padding-inline: var(--va-space-inline-sm);\n}\n\n.format-toolbar .icon {\n  display: block;\n  inline-size: 1.125rem;\n  block-size: 1.125rem;\n}\n"
}